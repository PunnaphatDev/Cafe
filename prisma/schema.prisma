generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String     @id @default(cuid())
  name        String
  category    String     @default("ทั่วไป")
  quantity    Int        @default(0)
  minStock    Int        @default(5)
  unit        String     @default("ชิ้น")
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  stockLogs   StockLog[]

  @@index([isActive, category])
  @@index([name])
  @@map("products")
}

model StockLog {
  id             String   @id @default(cuid())
  productId      String
  productName    String
  action         String   // IN, OUT, ADJUST
  oldQuantity    Int
  changeQuantity Int
  newQuantity    Int
  reason         String?
  userEmail      String?  @default("Staff")
  createdAt      DateTime @default(now())

  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([createdAt])
  @@map("stock_logs")
}

model CashTransaction {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  type        String   // EXPENSE, INCOME, CHANGE_FUND
  category    String   // สั่งน้ำแข็ง, เบิกเงินทอน, รายรับเงินสด, ฯลฯ
  amount      Float
  note        String?
  recordedBy  String?  @default("Staff")
  isActive    Boolean  @default(true)
  isClosed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, isClosed, date])
  @@index([type, isActive])
  @@index([date])
  @@map("cash_transactions")
}

model DailyReset {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  totalAmount Float    @default(0)
  itemCount   Int      @default(0)
  note        String?
  resetBy     String?  @default("Staff")
  createdAt   DateTime @default(now())

  @@index([date])
  @@map("daily_resets")
}
